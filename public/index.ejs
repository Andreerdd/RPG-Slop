<%- include('partials/header') %>

<main class="container page">
  <section class="hero">
    <div>
      <span class="badge">Cooperativo</span>
      <span class="badge">Em tempo real</span>
      <h1>Seu grupo, sua história, seu mundo.</h1>
      <p>
        O RPG-Slop reúne jogadores, NPCs e narrativas em uma mesa viva, com a ajuda de um Mestre automatizado
        que cria cenas, interpreta personagens e reage ao caminho do grupo.
      </p>
      <div class="actions">
        <a href="/cadastro" class="btn btn-primary">Criar conta</a>
        <a href="/login" class="btn btn-secondary">Entrar</a>
      </div>
    </div>
    <div class="panel">
      <h3>Resumo da sala</h3>
      <ul class="list">
        <li>4 jogadores online agora</li>
        <li>2 campanhas ativas</li>
        <li>1 vilão em debate</li>
        <li>Última cena: a ponte do desespero</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>O que você encontrará</h2>
    <div class="feature-grid">
      <article class="feature">
        <strong>Histórias dinâmicas</strong>
        <p>Cenas improvisadas, escolhas com impacto e NPCs com personalidade própria.</p>
      </article>
      <article class="feature">
        <strong>Mestre assistente</strong>
        <p>O sistema interpreta o ambiente e responde com descrições e desafios.</p>
      </article>
      <article class="feature">
        <strong>Jogos em grupo</strong>
        <p>Compartilhe a aventura em tempo real com sua mesa e mova a trama.</p>
      </article>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
