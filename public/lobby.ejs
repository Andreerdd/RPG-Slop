<%- include('partials/header') %>

<link rel="stylesheet" href="/css/lobby.css" />

<div class="lobby">
    <form id="enter-room-form" action="/sala" method="GET"></form>
    <div class="panel character-selection">
        <span class="tag" data-text="Seus personagens">Equipe de pesquisa</span>
        <% if (reqQuery.personagem === 'criado') { %>
        <p class="character-notice">Ficha criada e adicionada à sua equipe.</p>
        <% } %>
        <% if (reqQuery.erro === 'personagem') { %>
        <p class="form-error" role="alert">Selecione um personagem válido para entrar na sala.</p>
        <% } %>
        <div class="character-list">
            <% characters.forEach((character) => {
                let avatarUrl = character.imageUrl || "assets/avatar_template.png";
                avatarUrl = avatarUrl.replace(/^\/?public\//, "/");
                if (!avatarUrl.startsWith("/")) avatarUrl = `/${avatarUrl}`;
            %>
            <label class="character-card panel">
                <input class="character-radio" type="radio" name="characterId" value="<%= character.id %>" form="enter-room-form" required aria-label="Selecionar <%= character.name %>">
                <img class="selected-seal" src="../assets/selected_seal.svg" width="48px" height="48px" alt="Selecionado">
                <div class="lab-data">
                    <img src="../assets/penrose_red.svg" width="24px" height="24px">
                    <span>ARK LABORATÓRIOS</span>
                </div>
                <span class="card-label">CARTÃO DE PESQUISA</span>
                <img class="seal" src="../assets/seal2.png" width="96px" height="96px">

                <div class="avatar" style="background-image: url('<%= avatarUrl %>');"></div>

                <span class="document-number" data-text="DOCUMENTO"><%= character.id.match(/[0-9a-f]{2}/gi).slice(0, 4).map(h => String(parseInt(h, 16) % 99 + 1).padStart(2, '0')).join('.') %></span>

                <div class="sheet">
                    <span class="sheet-item" data-text="NOME"><%= character.name %></span>
                    <span class="sheet-item" data-text="CLASSE"><%= character.attributes.classe %></span>
                    <span class="sheet-item" data-text="DATA DE EXPEDIÇÃO"><%= character.createdAt.toLocaleDateString('pt-BR') %></span>
                    <div class="attributes">
                        <span class="attribute-item" data-text="FOR"><%= character.attributes.forca %></span>
                        <span class="attribute-item" data-text="AGI"><%= character.attributes.agilidade %></span>
                        <span class="attribute-item" data-text="INT"><%= character.attributes.intelecto %></span>
                        <span class="attribute-item" data-text="VIG"><%= character.attributes.vigor %></span>
                    </div>
                </div>

                <div class="barcode" style="--offset: <%= (Number(BigInt(('0x' + character.id.replace(/-/g, '')) ** 2) % 1000n) ** 7) % 231 %>px"></div>

            </label>
            <% }) %>
            <button class="create-character-button" id="create-character"><span>+</span></button>
        </div>
        <!-- <% if (characters.length) { %>
        <button class="enter-room-button" type="submit" form="enter-room-form">Entrar na sala com personagem selecionado</button>
        <% } else { %>
        <p class="empty-characters">Crie um personagem para poder entrar na sala.</p>
        <% } %> -->
    </div>
    
    <div class="room-selection">
        <div class="panel">
            <span class="tag" data-text="Criar uma campanha">Começar pesquisa</span>
            <label>
                Nome da Sala
            </label>
            <input type="text" id="nome-sala">
            <label>
                Tema da Sala
            </label>
            <textarea id="tema-sala"></textarea>
            <button type="submit">Criar e gerar campanha</button>
        </div>

        <div class="panel">
            <span class="tag" data-text="Entrar em uma campanha">Se juntar à pesquisa</span>
            <label>
                Código da Sala
            </label>
            <input type="text" id="codigo-sala" placeholder="A B C 1 2 3">
            <button type="submit">Entrar</button>
        </div>
    </div>

    <div class="click-blocker" id="click-blocker" style="display: none;"></div>
    <div class="character-creation panel" id="character-creation" style="display: none">
        <span class="tag" data-text="Criar novo personagem">Ficha de Contratação</span>

        <% if (reqQuery.erro === 'campos') { %>
        <p class="form-error" role="alert">Confira os campos: atributos devem estar entre 1 e 20.</p>
        <% } %>

        <form class="character-form" action="/personagem" method="POST">
            <label>
                Nome
                <input id="name" name="name" type="text" maxlength="100" placeholder="Nome do personagem" required />
            </label>

            <label>
                Classe
                <!-- <select id="characterClass" name="characterClass" required>
                    <option value="" disabled selected>Selecione uma classe</option>
                    <option>Explorador</option>
                    <option>Guardião</option>
                    <option>Técnico</option>
                    <option>Médico</option>
                    <option>Livre</option>
                </select> -->
                <div class="radio-field">
                    <div class="radio-div">
                        <label>
                            Explorador
                            <input type="radio" id="explorador" name="characterClass" value="explorador" data-text="Explorador" required>
                        </label>
                    </div>

                    <div class="radio-div">
                        <label>
                            Guardião
                            <input type="radio" id="guardiao" name="characterClass" value="guardiao" data-text="Guardião" required>
                        </label>
                    </div>

                    <div class="radio-div">
                        <label>
                            Técnico
                            <input type="radio" id="tecnico" name="characterClass" value="tecnico" data-text="Técnico" required>
                        </label>
                    </div>

                    <div class="radio-div">
                        <label>
                            Médico
                            <input type="radio" id="medico" name="characterClass" value="medico" data-text="Médico" required>
                        </label>
                    </div>
                </div>
            </label>

            <label>
                <span>Aparência</span>
                <textarea id="appearance" name="appearance" rows="4" maxlength="2000" placeholder="Descreva o que se nota ao olhar para ele..." required></textarea>
            </label>

            <fieldset class="attribute-fields">
                <legend>Atributos <span>01—20</span></legend>
                <label>
                    <span>Força</span>
                    <input id="forca" name="forca" type="number" min="1" max="20" value="10" required />
                </label>
                <label>
                    <span>Agilidade</span>
                    <input id="agilidade" name="agilidade" type="number" min="1" max="20" value="10" required />
                </label>
                <label>
                    <span>Intelecto</span>
                    <input id="intelecto" name="intelecto" type="number" min="1" max="20" value="10" required />
                </label>
                <label>
                    <span>Vigor</span>
                    <input id="vigor" name="vigor" type="number" min="1" max="20" value="10" required />
                </label>
            </fieldset>

            <div class="form-actions">
                <a class="button cancel-button" style="--cor: var(--red)" href="/">Cancelar</a>
                <button type="submit" style="flex-grow: 1;">Criar personagem</button>
            </div>
        </form>
    </div>
</div>

<script>
    const clickBlocker = document.getElementById("click-blocker");
    const createCharacterPanel = document.getElementById("character-creation");
    const createCharacterButton = document.getElementById("create-character");
    createCharacterButton.addEventListener("click", () => {
        createCharacterPanel.style.display = "flex";
        clickBlocker.style.display = "flex";
    })

    try {
        const savedCharacterId = localStorage.getItem("selectedCharacterId");
        if (savedCharacterId) {
            const matchingRadio = document.querySelector(`input.character-radio[value="${savedCharacterId}"]`);
            if (matchingRadio) {
                matchingRadio.checked = true;
            }
        }

        document.querySelectorAll("input.character-radio").forEach((radio) => {
            radio.addEventListener("change", () => {
                if (radio.checked) {
                    try {
                        localStorage.setItem("selectedCharacterId", radio.value);
                    } catch (e) {
                        console.error("Erro ao salvar personagem selecionado:", e);
                    }
                }
            });
        });
    } catch (e) {
        console.error("Erro ao acessar localStorage:", e);
    }
</script>

<%- include('partials/footer') %>
